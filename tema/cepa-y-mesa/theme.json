{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "name": "Crema", "slug": "base", "color": "#f6f0e6" },
				{ "name": "Tinta", "slug": "contrast", "color": "#241418" },
				{ "name": "Vino", "slug": "accent-1", "color": "#7a2338" },
				{ "name": "Crema tostada", "slug": "accent-2", "color": "#ece2d2" },
				{ "name": "Oro", "slug": "accent-3", "color": "#946a2c" },
				{ "name": "Gris cálido", "slug": "accent-4", "color": "#6e605c" },
				{ "name": "Blanco roto", "slug": "accent-5", "color": "#fffaf3" },
				{ "name": "Oliva", "slug": "accent-6", "color": "#4f5a33" }
			]
		},
		"layout": { "contentSize": "760px", "wideSize": "1240px" },
		"typography": {
			"fontFamilies": [
				{
					"name": "Outfit",
					"slug": "outfit",
					"fontFamily": "Outfit, system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "Outfit", "fontStyle": "normal", "fontWeight": "300 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/outfit.woff2" ] }
					]
				},
				{
					"name": "DM Serif Display",
					"slug": "dm-serif",
					"fontFamily": "\"DM Serif Display\", Georgia, serif",
					"fontFace": [
						{ "fontFamily": "DM Serif Display", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/dm-serif.woff2" ] },
						{ "fontFamily": "DM Serif Display", "fontStyle": "italic", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/dm-serif-italic.woff2" ] }
					]
				}
			]
		}
	},
	"styles": {
		"color": { "background": "var:preset|color|base", "text": "var:preset|color|contrast" },
		"typography": { "fontFamily": "var:preset|font-family|outfit", "fontSize": "17px", "lineHeight": "1.6", "fontWeight": "400" },
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var:preset|font-family|dm-serif", "fontWeight": "400", "letterSpacing": "-0.01em", "lineHeight": "1.08" },
				"color": { "text": "var:preset|color|contrast" }
			},
			"link": {
				"color": { "text": "var:preset|color|contrast" },
				":hover": { "color": { "text": "var:preset|color|accent-1" } }
			},
			"button": {
				"color": { "background": "var:preset|color|contrast", "text": "var:preset|color|accent-5" },
				"border": { "radius": "999px" },
				"typography": { "fontFamily": "var:preset|font-family|outfit", "fontWeight": "600", "fontSize": "15px" },
				"spacing": { "padding": { "top": "14px", "bottom": "14px", "left": "26px", "right": "26px" } },
				":hover": { "color": { "background": "var:preset|color|accent-1", "text": "var:preset|color|accent-5" } }
			}
		}
	}
}
